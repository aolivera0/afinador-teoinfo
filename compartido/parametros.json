{
  "version": 1,
  "_nota": "Valores por defecto comunes a la app (TypeScript) y al análisis (Python). Los marcados en 'provisionales' se calibran en el bloque 3 (antes del vie 4 dic); cualquier cambio se hace por PR y lo revisan los tres. Significado de cada campo: docs/contratos.md, sección 3.",
  "provisionales": ["compuerta.rms_min_dbfs", "compuerta.entropia_max", "deteccion_cuerda.histeresis_cents"],

  "referencia_la4_hz": 440,
  "rango": { "f_min_hz": 25, "f_max_hz": 2000 },

  "tramo": { "N": 4096, "salto": 512, "ventana": "hann" },
  "preprocesado": { "pasa_altas_hz": 20, "pasa_altas_orden": 2, "quitar_media": true },

  "compuerta": { "rms_min_dbfs": -50, "entropia_max": 0.6 },

  "fft": { "factor_zero_padding": 2, "interpolacion": "parabolica-log" },
  "hps": { "R": 5, "factor_zero_padding": 2 },
  "yin": { "umbral": 0.1 },

  "nota": { "mediana_tramos": 5, "afinado_cents": 5 },
  "deteccion_cuerda": { "histeresis_cents": 30 },

  "evaluacion": { "ignorar_inicio_s": 0.2, "duracion_max_s": 2.0 }
}
